# =====================================================================
# 서버 구성 (지금은 둘 다 이 서버 192.168.0.147 에서 돈다)
#
#   [웹 서버]  compose.web.yml 로 띄움 = Apache + PHP 컨테이너 1개
#              ├─ 쇼핑몰 화면       /index.php, /login.php ...
#              ├─ v2 API (정식)     /api/v2/*  → JWT 로그인 필요
#              └─ v1 API (레거시)   /api/v1/*  → 같은 컨테이너 안에 있음.
#                                    별도 서버가 아니라 Apache 설정으로
#                                    접근 IP만 V1_ALLOWED_NET 으로 제한한다.
#   [DB 서버]  compose.db.yml 로 띄움 = MySQL 컨테이너 1개
#
#   나중에 DMZ/LAN 분리: 웹 서버 → DMZ, DB 서버 → LAN 으로 옮기고
#   아래 "주소" 값만 바꾼다. (이 파일은 두 서버에 각각 하나씩 둔다)
# =====================================================================

# ---------- 비밀값 ----------
# [웹 서버가 사용] JWT 토큰 서명 키. 바꾸면 모든 사용자가 다시 로그인해야 한다.
JWT_SECRET=change-me
# [DB 서버가 사용] MySQL root 비밀번호. DB 볼륨을 처음 만들 때만 적용된다.
MYSQL_ROOT_PASSWORD=change-me
# [웹 서버가 사용] 앱이 DB에 접속할 때 쓰는 shopapp 계정 비밀번호
#                  (deploy/mysql-init/02-user.sql 의 값과 같아야 한다)
DB_PASSWORD=change-me

# ---------- 주소 (서버 이전 시 여기만 바꾼다) ----------
#
#   이전 (구):  웹 + DB 둘 다 192.168.0.147 한 대
#   지금:      웹 서버 = 192.168.20.10 (DMZ),  DB 서버 = 192.168.10.20 (LAN)
#
#   ※ 아래 값 중 DB_HOST / DB_BIND 는 둘 다 "DB 서버의 IP" 다.
#     둘 다 DB 를 가리키는 값이라 분리 후에도 같은 값(LAN IP)이 들어간다.
#     웹 서버(DMZ) 자신의 IP 는 WEB_BIND 하나뿐이다.

# ===== [웹 서버 = DMZ] 웹 서버에 둘 .env 에서 바꾸는 값 =====
# 웹 서버가 80 포트를 열 자기 자신의 IP.  0.0.0.0 = 서버의 모든 IP 로 연다
#   0.0.0.0 그대로 두면 된다 (특정 IP만 열려면 웹 서버 자신의 IP 192.168.20.10)
WEB_BIND=0.0.0.0
# 웹이 접속하러 갈 DB 서버의 IP  (웹 서버 IP 아님!)
#   = LAN 에 있는 DB 서버 192.168.10.20
DB_HOST=192.168.10.20
# v1 레거시 API(/api/v1/*)를 호출할 수 있는 PC 대역. 이 밖에서 부르면 403
#   팀 PC 대역 (팀 PC 가 다른 대역으로 옮기면 여기를 바꾼다)
V1_ALLOWED_NET=192.168.0.0/24
# 앞단 WAF(ModSecurity 프록시) 컨테이너의 IP. 여기서 온 요청만 X-Forwarded-For 를 믿고
#   실제 클라이언트 IP 로 바꿔 기록/판정한다.
#   compose.web.yml 에서 waf 에 고정한 ipv4_address 와 같은 값이어야 한다
WAF_PROXY_NET=172.30.0.10

# ===== [웹 서버 = DMZ] WAF (ModSecurity v2 + OWASP CRS) =====
# 서버에 docker load 한 WAF 이미지 이름:태그 (sudo docker images 에 보이는 그대로)
#   비워 두면 compose.web.yml 의 기본값(아래와 같은 태그)을 쓴다
#   apache 계열 태그를 쓸 것 (nginx 계열은 ModSecurity v3)
WAF_IMAGE=owasp/modsecurity-crs:4.25.2-apache-202610180210-lts
# On = 탐지 + 차단(403) / DetectionOnly = 탐지·기록만 (차단 안 함)
WAF_RULE_ENGINE=On
# CRS 민감도 1~4 (높을수록 많이 잡지만 오탐도 많다)
WAF_PARANOIA=1

# ===== [DB 서버 = LAN] DB 서버에 둘 .env 에서 바꾸는 값 =====
# DB 서버가 3306 포트를 열 자기 자신의 IP
#   = DB 서버 자신의 IP 192.168.10.20 (웹 쪽 DB_HOST 와 같은 값)
DB_BIND=192.168.10.20

# ===== [공통] 보통 바꿀 일 없음 =====
# MySQL 포트. DB 서버는 이 포트로 열고, 웹 서버는 이 포트로 접속한다
DB_PORT=3306
