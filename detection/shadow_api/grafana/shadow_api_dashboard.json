            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "terms",
              "field": "data.method",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            },
            {
              "id": "3",
              "type": "terms",
              "field": "data.path",
              "settings": {
                "size": "15",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            }
          ],
          "timeField": "timestamp"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
