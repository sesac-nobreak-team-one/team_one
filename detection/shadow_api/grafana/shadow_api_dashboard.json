            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "최고 단계"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "5": {
                        "text": "L1 정찰",
                        "color": "blue",
                        "index": 0
                      },
                      "6": {
                        "text": "명세 밖(기타)",
