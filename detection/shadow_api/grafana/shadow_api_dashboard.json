                        "index": 1
                      },
                      "8": {
                        "text": "L2 발견",
                        "color": "yellow",
                        "index": 2
                      },
                      "10": {
                        "text": "L3-E / F1",
                        "color": "purple",
                        "index": 3
                      },
                      "12": {
                        "text": "L3 악용",
                        "color": "orange",
                        "index": 4
