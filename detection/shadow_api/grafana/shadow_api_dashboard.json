    {
      "id": 3,
      "type": "table",
      "title": "위험 IP 순위",
      "description": "IP별 경보 수와 최고 도달 단계. 최고 레벨 순으로 정렬.",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 10
      },
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_WAZUH_ALERTS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "${DS_WAZUH_ALERTS}"
          },
          "queryType": "lucene",
          "luceneQueryType": "Metric",
          "query": "rule.groups:shadow_api AND data.client_ip:$ip",
          "alias": "",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            },
            {
              "id": "3",
              "type": "max",
              "field": "rule.level"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "terms",
              "field": "data.client_ip",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "3",
                "min_doc_count": "1"
              }
            }
          ],
          "timeField": "timestamp"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "data.client_ip": "IP",
              "Count": "경보 수",
              "Max rule.level": "최고 단계",
              "Max": "최고 단계"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "최고 단계",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
