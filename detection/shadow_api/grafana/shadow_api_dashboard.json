{
  "__inputs": [
    {
      "name": "DS_WAZUH_ALERTS",
      "label": "Wazuh 경보 (wazuh-alerts-*)",
      "description": "wazuh-alerts-* 인덱스, 시간 필드 timestamp 로 만든 OpenSearch 데이터 소스",
      "type": "datasource",
      "pluginId": "grafana-opensearch-datasource",
      "pluginName": "OpenSearch"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "grafana-opensearch-datasource",
      "name": "OpenSearch",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "bargauge",
      "name": "Bar gauge",
      "version": ""
    }
  ],
  "title": "Shadow API 탐지",
  "uid": "shadow-api-detect",
  "description": "openapi.yaml 명세 대조 룰(Shadow API) 경보 대시보드. 통합 계획서 7장.",
  "tags": [
    "shadow_api",
    "wazuh"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "ip",
        "label": "IP 필터 (* = 전체)",
        "type": "textbox",
        "query": "*",
        "current": {
          "text": "*",
          "value": "*"
        },
        "options": [
          {
            "selected": true,
            "text": "*",
            "value": "*"
          }
        ],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "기간 내 단계별 경보 수",
      "description": "오른쪽 위 시간 범위 안의 경보 건수. L3(악용)·F2(대량 유출)가 0보다 크면 개인정보 노출이 일어난 것.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_WAZUH_ALERTS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "${DS_WAZUH_ALERTS}"
          },
          "queryType": "lucene",
          "luceneQueryType": "Metric",
          "query": "rule.groups:shadow_api_recon AND data.client_ip:$ip",
          "alias": "L1 정찰",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "field": "timestamp",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0",
                "trimEdges": "0"
              }
            }
          ],
          "timeField": "timestamp"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "${DS_WAZUH_ALERTS}"
          },
          "queryType": "lucene",
          "luceneQueryType": "Metric",
          "query": "rule.groups:shadow_api_discovery AND data.client_ip:$ip",
          "alias": "L2 발견",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "field": "timestamp",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0",
                "trimEdges": "0"
              }
            }
          ],
          "timeField": "timestamp"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "${DS_WAZUH_ALERTS}"
          },
          "queryType": "lucene",
          "luceneQueryType": "Metric",
          "query": "rule.groups:shadow_api_exploit AND data.client_ip:$ip",
          "alias": "L3 악용",
