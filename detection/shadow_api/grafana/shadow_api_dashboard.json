          "queryType": "lucene",
          "luceneQueryType": "Metric",
          "query": "rule.groups:shadow_api_mass_exfil AND data.client_ip:$ip",
          "alias": "F2 대량 유출",
          "metrics": [
            {
              "id": "1",
              "type": "count"
